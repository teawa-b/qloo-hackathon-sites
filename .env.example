# Required: Qloo taste data (hackathon keys work only on the hackathon host)
QLOO_API_KEY=
QLOO_API_HOST=https://hackathon.api.qloo.com

# LLM: set one key. Without any, a scripted (non-LLM) pipeline runs instead.
# OpenRouter is recommended: one key reaches Claude, OpenAI and Gemini models. Defaults are cheap:
#   LLM_MODEL       the agent, briefs and web research  (default anthropic/claude-haiku-5.5)
#   LLM_FAST_MODEL  Talk Coach turns, photo sorting     (default google/gemini-2.5-flash-lite)
# Any OpenRouter model id works, e.g. openai/gpt-5-mini, openai/gpt-5-nano, google/gemini-3-flash-preview.
OPENROUTER_API_KEY=
# LLM_MODEL=anthropic/claude-haiku-5.5
# LLM_FAST_MODEL=google/gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Image editing: FAL_KEY runs GPT Image 2.5 Flare (default; GPT_IMAGE_MODEL=openai/gpt-image-2/edit to switch). PRUNAAI_KEY adds Pruna p-image-edit as a fallback
# (or primary with IMAGE_PROVIDER=pruna); FLUX 3 Edit is the last resort.
# GPT_IMAGE_QUALITY=medium
PRUNAAI_KEY=
FAL_KEY=
# FAL_IMAGE_MODEL=blackforestlabs/flux-3/edit-image

# Live commercial listings (LoopNet) near the clicked point, via https://www.realtyapi.io
REALTYAPI_KEY=
# LISTING_SEARCHES_PER_HOUR=20

# Live walkthrough uses FAL_KEY (fal real-time world model). Sessions end after LIVE_MAX_SECONDS.
# FAL_WORLD_MODEL=robbyant/lingbot-world-2
# LIVE_MAX_SECONDS=180
# LIVE_SESSIONS_PER_HOUR=2
# LIVE_SESSIONS_PER_IP_PER_DAY=3
# LIVE_SESSIONS_PER_DAY=20
# Roomful 3D rooms (fal Luma Reframe + MoGe-2, about 2 cents each, two calls per room) also use FAL_KEY
# ROOMS_3D_PER_HOUR=20
# ROOMS_3D_PER_DAY=300
# FAL_IMAGE_RESOLUTION=1k

# Optional alternative: 3D splat walkthroughs via World Labs Marble
WORLDLABS_API_KEY=
# WORLDLABS_MODEL=marble-1.1

# Optional alternative: LoopNet listings through an Apify actor (scraping LoopNet is against its terms; your call)
APIFY_TOKEN=

# Abuse limits for a public deployment (agent runs cover venues, activations, taste rooms and pitch briefs)
TALK_SESSIONS_PER_HOUR=6
TALK_SESSIONS_PER_DAY=100
TALK_TURNS_PER_HOUR=400
AGENT_RUNS_PER_HOUR=5
AGENT_RUNS_PER_IP_PER_DAY=12
AGENT_RUNS_PER_DAY=200
BASELINES_PER_HOUR=12
WORLDS_PER_HOUR=3
WORLDS_PER_DAY=25
PORT=3300
