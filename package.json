{
  "name": "qloo-hackathon-sites",
  "version": "1.0.0",
  "description": "Four Qloo-powered apps sharing one codebase: Openhere, Roomful, Pitchprep and SmallTalk.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node dev.js",
    "start": "node --env-file-if-exists=.env server.js",
    "start:openhere": "node --env-file-if-exists=.env server.js --site=openhere",
    "start:room": "node --env-file-if-exists=.env server.js --site=room",
    "start:pitch": "node --env-file-if-exists=.env server.js --site=pitch",
    "start:talk": "node --env-file-if-exists=.env server.js --site=talk",
    "start:lab": "node --env-file-if-exists=.env server.js --site=lab",
    "test": "node --test"
  },
  "engines": { "node": ">=22" }
}
